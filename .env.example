# Worker Service Configuration
# Copy this file to .env and update with your actual values

# Database (same as backend/API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whazz_audio

# RabbitMQ (Message Broker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@localhost:5432/whazz_audio

# Storage Configuration
USE_LOCAL_STORAGE=true
UPLOAD_DIR=./uploads
OUTPUT_DIR=./processed_audio

# S3/MinIO (if USE_LOCAL_STORAGE=false)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=wazz-audio
S3_REGION=us-east-1

# Audio Processing
CLEARVOICE_MODEL_NAME=MossFormer2_SE_48K
MAX_FILE_SIZE_MB=100
FILE_EXPIRY_HOURS=24

# Worker Configuration
# Number of worker processes (default: number of CPUs)
# CELERY_WORKER_CONCURRENCY=4

# Queues to listen to (comma-separated)
# CELERY_QUEUES=audio_processing,maintenance
