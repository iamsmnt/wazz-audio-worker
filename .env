# Worker Service Configuration
# IMPORTANT: Use absolute paths so both backend and worker access the same files

# =========================================================================
# Database Settings
# =========================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whazz_audio

# =========================================================================
# Message Broker - RabbitMQ
# =========================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@localhost:5432/whazz_audio

# =========================================================================
# File Storage Settings - ABSOLUTE PATHS
# =========================================================================
# CRITICAL: Use the same paths as backend so worker can access uploaded files
USE_LOCAL_STORAGE=true
UPLOAD_DIR=/Users/somnathmahato/hobby-projects/wazz-audio/backend/uploads
OUTPUT_DIR=/Users/somnathmahato/hobby-projects/wazz-audio/backend/processed_audio

# File validation
MAX_FILE_SIZE_MB=100
FILE_EXPIRY_HOURS=24

# =========================================================================
# Audio Processing Settings
# =========================================================================
CLEARVOICE_MODEL_NAME=MossFormer2_SE_48K
PROCESSING_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=2

# =========================================================================
# Application Settings
# =========================================================================
APP_NAME=Whazz Audio Worker
DEBUG=true
ENVIRONMENT=development
